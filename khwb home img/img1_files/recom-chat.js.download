iți chatul?",pt_BR:"Deseja sair do chat?",th_TH:"ต้องการออกจากแชทหรือไม่",cs_CZ:"Chcete chat opustit?",hu_HU:"ki szeretne lépni a csevegésből?",ca_ES:"Vols sortir del xat?",ar_SA:"هل تريد/ين الخروج من الدردشة؟",gl_ES:"Queres saír do chat?",es_MX:"¿desear salir del chat?",sk_SK:"Chcete opustiť chat?",es_ES:"¿desear salir del chat?",nl_NL:"Wil je de chat verlaten?",sq_AL:"Dëshiron të dalësh nga chat-i?",sv_SE:"vill du lämna chatten?",da_DK:"vil du forlade chatten?",sr_RS:"Da li želite da zatvorite ćaskanje?",hr_HR:"Želite li izaći iz chata?",ko_KR:"채팅을 종료하시겠습니까?",en_US:"Do you want to abandon the chat?",lt_LT:"Norite išeiti iš pokalbio?",kk_KZ:"чаттан шыққыңыз келе ме?",no_NO:"Vil du forlate chatten?",it_IT:"Vuoi lasciare la chat?",ru_RU:"хотите выйти из чата?",el_GR:"θέλετε να φύγετε από τη συνομιλία;",pl_PL:"chcesz opuścić czat?",ar_LB:"هل تريد/ين الخروج من الدردشة؟",tr_TR:"Sohbetten çıkmak mı istiyorsunuz?",id_ID:"Apakah Anda ingin keluar dari obrolan?",he_IL:"האם אתם רוצים לצאת מהצ'אט?",fr_FR:"souhaitez-vous quitter le chat ?",ja_JP:"チャットを終了しますか？",de_DE:"Wollen Sie den Chat verlassen?",zh_TW:"您是否要退出聊天室？",uz_UZ:"suhbatni tark etishni xohlaysizmi?",eu_ES:"txat-etik irten nahi duzu?",bg_BG:"искате да напуснете чата?",vi_VN:"Bạn muốn rời khỏi cuộc trò chuyện?",mk_MK:"Дали сакате да излезете од разговорот?",ar_MA:"هل تريد/ين الخروج من الدردشة؟",fi_FI:"haluatko poistua chatista?",en_GB:"want to leave the chat?",et_EE:"soovid vestlusest lahkuda?",ka_GE:"გსურთ ჩატიდან გასვლა?",uk_UA:"Хочете вийти з чата?",lv_LV:"Vai vēlaties atstāt tērzēšanu?",zh_CN:"想要退出聊天？",sl_SI:"Želite zapustiti klepet?",ar_AE:"هل تريد/ين الخروج من الدردشة؟",pt_PT:"sair do chat?"},"date-pill.yesterday":{ro_RO:"Ieri",pt_BR:"Ontem",th_TH:"เมื่อวาน",cs_CZ:"Včera",hu_HU:"Tegnap",ca_ES:"Ahir",ar_SA:"البارحة",gl_ES:"Onte",es_MX:"Ayer",sk_SK:"Včera",es_ES:"Ayer",nl_NL:"Gisteren",sq_AL:"Dje",sv_SE:"Igår",da_DK:"I går",sr_RS:"Juče",hr_HR:"Jučer",ko_KR:"어제",en_US:"Yesterday",lt_LT:"Vakar",kk_KZ:"Кеше",no_NO:"I går",it_IT:"Ieri",ru_RU:"Вчера",el_GR:"Χθες",pl_PL:"Wczoraj",ar_LB:"البارحة",tr_TR:"Dün",id_ID:"Kemarin",he_IL:"אתמול",fr_FR:"Hier",ja_JP:"昨日",de_DE:"Gestern",zh_TW:"昨天",uz_UZ:"Kecha",eu_ES:"Atzo",bg_BG:"Вчера",vi_VN:"Hôm qua",mk_MK:"Вчера",ar_MA:"البارحة",fi_FI:"Eilen",en_GB:"Yesterday",et_EE:"Eile",ka_GE:"გუშინ",uk_UA:"Вчора",lv_LV:"Vakar",zh_CN:"昨日",sl_SI:"Včeraj",ar_AE:"البارحة",pt_PT:"Ontem"},"chat-writer.user-message-send-button":{ro_RO:"Trimitere",pt_BR:"Enviar",th_TH:"ส่ง",cs_CZ:"Poslat",hu_HU:"Küldés",ca_ES:"Envia",ar_SA:"إرسال",gl_ES:"Enviar",es_MX:"Enviar",sk_SK:"Poslať",es_ES:"Enviar",nl_NL:"Verzenden",sq_AL:"Dërgo",sv_SE:"Skicka",da_DK:"Send",sr_RS:"Pošalji",hr_HR:"Pošalji",ko_KR:"전송",en_US:"Send",lt_LT:"Siųsti",kk_KZ:"Жіберу",no_NO:"Send",it_IT:"Invia",ru_RU:"Отправить",el_GR:"Αποστολή",pl_PL:"Wyślij",ar_LB:"إرسال",tr_TR:"Gönder",id_ID:"Mengirim",he_IL:"לשלוח",fr_FR:"Envoyer",ja_JP:"送信する",de_DE:"Senden",zh_TW:"傳送",uz_UZ:"Yuborish",eu_ES:"Bidali",bg_BG:"Изпрати",vi_VN:"Gửi",mk_MK:"Испрати",ar_MA:"إرسال",fi_FI:"Lähetä",en_GB:"Send",et_EE:"Saada",ka_GE:"გაგზავნა",uk_UA:"Надіслати",lv_LV:"Sūtīt",zh_CN:"发送",sl_SI:"Pošlji",ar_AE:"إرسال",pt_PT:"Enviar"},"logout-confirmation-dialog.content.guest":{ro_RO:"Dacă închideți chatul, veți pierde această conversație.",pt_BR:"Se fechar o chat, perderá esta conversa.",th_TH:"หากคุณปิดการสนทนา บทสนทนานี้จะหายไป",cs_CZ:"Pokud chat zavřete, přijdete o tuto konverzaci.",hu_HU:"Ha bezárja a csevegést, akkor ez a beszélgetés elveszik.",ca_ES:"Si tanqueu el xat, perdreu aquesta conversa.",ar_SA:"ستضيع المحادثة إذا أغلقت هذه النافذة.",gl_ES:"Se pechas o chat, perderás esta conversa.",es_MX:"Si cierras el chat, perderás esta conversación.",sk_SK:"Ak chat zatvoríte, prídete o túto konverzáciu.",es_ES:"Si cierras el chat, perderás esta conversación.",nl_NL:"Als je de chat sluit, gaat dit gesprek verloren.",sq_AL:"Nëse e mbyll chat-in, do ta humbasësh këtë bisedë.",sv_SE:"Om du stänger chatten kommer du att förlora den här konversationen.",da_DK:"Hvis du lukker chatten, mister du denne samtale.",sr_RS:"Ako zatvorite ćaskanje, izgubićete ovaj razgovor.",hr_HR:"Ako zatvorite chat, izgubit ćete ovaj razgovor.",ko_KR:"채팅을 닫으면 이 대화가 삭제됩니다.",en_US:"If you close the chat, you will lose this conversation.",lt_LT:"Jei uždarysite pokalbio langą, prarasite šį pokalbį.",kk_KZ:"Егер чатты жапсаңыз, бұл әңгімені жоғалтасыз.",no_NO:"Hvis du lukker chatten, vil du miste denne samtalen.",it_IT:"Se chiudi la chat, perderai questa conversazione.",ru_RU:"Если вы закроете чат, эта беседа пропадет.",el_GR:"Εάν κλείσετε το chat, θα χάσετε αυτή τη συνομιλία.",pl_PL:"Zamknięcie czatu spowoduje utratę tej rozmowy.",ar_LB:"ستضيع المحادثة إذا أغلقت هذه النافذة.",tr_TR:"Sohbeti kapatırsanız bu konuşmayı kaybedeceksiniz.",id_ID:"Jika Anda menutup chat ini, maka Anda akan kehilangan percakapan ini.",he_IL:"אם תסגרו את הצ'אט, שיחה זו תימחק.",fr_FR:"Si vous fermez le chat, vous perdrez cette conversation.",ja_JP:"チャットを閉じると、この会話は失われます。",de_DE:"Wenn Sie den Chat schließen, verlieren Sie diese Konversation.",zh_TW:"如果您關閉聊天視窗，對話內容將會遺失。",uz_UZ:"Bu chatni yopsangiz, ushbu suhbat oʻchib ketadi.",eu_ES:"Txata ixten baduzu, hizketaldi hau galduko duzu.",bg_BG:"Ако затворите чата, ще изгубите този разговор.",vi_VN:"Nếu bạn đóng cửa sổ trò chuyện, bạn sẽ mất cuộc trò chuyện này.",mk_MK:"Ако го затворите прозорчето со разговорот, разговорот ќе заврши.",ar_MA:"ستضيع المحادثة إذا أغلقت هذه النافذة.",fi_FI:"Jos suljet chatin, menetät tämän keskustelun.",en_GB:"If you close the chat, you will lose this conversation.",et_EE:"Vestlusakna sulgemisel kaob vestlus.",ka_GE:"თუ ჩატს დახურავთ, ეს საუბარი დაიკარგება.",uk_UA:"Якщо ви закриєте чат, цю розмову буде втрачено.",lv_LV:"Ja aizvērsi tērzētavu, zaudēsi šo sarunu.",zh_CN:"如果您关闭聊天，将丢失此对话。",sl_SI:"Če zaprete klepet, ga ne boste mogli obnoviti.",ar_AE:"ستضيع المحادثة إذا أغلقت هذه النافذة.",pt_PT:"Se fechar o chat, perderá esta conversa."},"toast.downloaded-img":{ro_RO:"Fotografie salvată",pt_BR:"Foto salva",th_TH:"บันทึกภาพเรียบร้อย",cs_CZ:"Fotografie uložena",hu_HU:"Mentett fénykép",ca_ES:"Foto guardada",ar_SA:"صورة محفوظة",gl_ES:"Foto gardada",es_MX:"Foto guardada",sk_SK:"Fotografia sa uložila",es_ES:"Foto guardada",nl_NL:"Foto opgeslagen",sq_AL:"Fotografi e ruajtur",sv_SE:"Foto sparat",da_DK:"Gemt foto",sr_RS:"Spremljena fotografija",hr_HR:"Spremljena fotografija",ko_KR:"사진 저장 완료",en_US:"Photo saved",lt_LT:"Išsaugota nuotrauka",kk_KZ:"Сақталған фотосурет",no_NO:"Foto lagret",it_IT:"Foto salvata",ru_RU:"Фотография сохранена",el_GR:"Αποθηκευμένη φωτογραφία",pl_PL:"Zdjęcie zapisane",ar_LB:"صورة محفوظة",tr_TR:"Fotoğraf kaydedildi",id_ID:"Foto tersimpan",he_IL:"תמונה שמורה",fr_FR:"Photo enregistrée",ja_JP:"写真を保存しました",de_DE:"Foto gespeichert",zh_TW:"已儲存相片",uz_UZ:"Saqlangan rasm",eu_ES:"Argazkia gorde da",bg_BG:"Снимката е запазена",vi_VN:"Ảnh đã lưu",mk_MK:"Фотографијата е зачувана",ar_MA:"صورة محفوظة",fi_FI:"Kuva tallennettu",en_GB:"Saved photo",et_EE:"Foto salvestatud",ka_GE:"ფოტო შენახულია",uk_UA:"Збережене фото",lv_LV:"Saglabātā fotogrāfija",zh_CN:"照片已保存",sl_SI:"Shranjena fotografija",ar_AE:"صورة محفوظة",pt_PT:"Foto guardada"},"download-image.download-icon":{ro_RO:"Descărcați imaginea",pt_BR:"Baixar imagem",th_TH:"ดาวน์โหลดภาพ",cs_CZ:"Stáhnout obrázek",hu_HU:"Kép letöltése",ca_ES:"Baixa la imatge",ar_SA:"تنزيل الصورة",gl_ES:"Descargar imaxe",es_MX:"Descargar imagen",sk_SK:"Stiahnuť obrázok",es_ES:"Descargar imagen",nl_NL:"Afbeelding downloaden",sq_AL:"Shkarko imazhin",sv_SE:"Ladda ned bilden",da_DK:"Download billede",sr_RS:"Preuzmi fotografiju",hr_HR:"Preuzmi fotografiju",ko_KR:"이미지 다운로드",en_US:"Download image",lt_LT:"Atsisiųsti paveikslėlį",kk_KZ:"Кескінді жүктеп алу",no_NO:"Last ned bilde",it_IT:"Download immagine",ru_RU:"Скачать изображение",el_GR:"Λήψη εικόνας",pl_PL:"Pobierz obraz",ar_LB:"تنزيل الصورة",tr_TR:"Görseli indir",id_ID:"Mengunduh gambar",he_IL:"הורדת תמונה...",fr_FR:"Télécharger l'image",ja_JP:"画像をダウンロードする",de_DE:"Bild herunterladen",zh_TW:"下載圖片",uz_UZ:"Tasvirni yuklab olish",eu_ES:"Deskargatu irudia",bg_BG:"Изтегляне на изображение",vi_VN:"Tải xuống hình ảnh",mk_MK:"Преземање слика",ar_MA:"تنزيل الصورة",fi_FI:"Lataa kuva",en_GB:"Download image",et_EE:"Laadi kujutis alla...",ka_GE:"სურათის ჩამოტვირთვა",uk_UA:"Завантажити зображення",lv_LV:"Lejupielādēt attēlu",zh_CN:"下载图片",sl_SI:"Prenos slike",ar_AE:"تنزيل الصورة",pt_PT:"Descarregar imagem"},"messages.provider-image":{ro_RO:"Fișier atașat",pt_BR:"Arquivo anexo",th_TH:"ไฟล์ที่แนบ",cs_CZ:"Přiložený soubor",hu_HU:"Melléklet",ca_ES:"Arxiu adjunt",ar_SA:"ملف مرفق",gl_ES:"Arquivo adxunto",es_MX:"Archivo adjunto",sk_SK:"Pripojený súbor",es_ES:"Archivo adjunto",nl_NL:"Bijgevoegd bestand",sq_AL:"Skedar i bashkëngjitur",sv_SE:"Bifogad fil",da_DK:"Vedhæftet fil",sr_RS:"Priložena datoteka",hr_HR:"Priložena datoteka",ko_KR:"첨부 파일",en_US:"File attached",lt_LT:"Pridedamas failas",kk_KZ:"Тіркелген файл",no_NO:"Vedlagt fil",it_IT:"File allegato",ru_RU:"Прикрепленный файл",el_GR:"Συνημμένο αρχείο",pl_PL:"Plik w załączniku",ar_LB:"ملف مرفق",tr_TR:"Ekli dosya",id_ID:"Berkas terlampir",he_IL:"קובץ מצורף",fr_FR:"Fichier joint",ja_JP:"添付ファイル",de_DE:"Angehängte Datei",zh_TW:"附加檔案",uz_UZ:"Biriktirilgan fayl",eu_ES:"Fitxategi erantsia",bg_BG:"Приложен файл",vi_VN:"Tệp đính kèm",mk_MK:"Прикачена датотека",ar_MA:"ملف مرفق",fi_FI:"Liitetiedosto",en_GB:"Attached file",et_EE:"Lisatud fail",ka_GE:"თანდართული ფაილი",uk_UA:"Прикріплений файл",lv_LV:"Pievienots fails",zh_CN:"附件",sl_SI:"Priložena datoteka",ar_AE:"ملف مرفق",pt_PT:"Ficheiro anexo"},"toast.action-close":{ro_RO:"Închidere",pt_BR:"Fechar",th_TH:"ปิด",cs_CZ:"Zavřít",hu_HU:"Bezárás",ca_ES:"Tanca",ar_SA:"إغلاق",gl_ES:"Pechar",es_MX:"Cerrar",sk_SK:"Zatvoriť",es_ES:"Cerrar",nl_NL:"Afsluiten",sq_AL:"Mbyll",sv_SE:"Stäng",da_DK:"Luk",sr_RS:"Zatvori",hr_HR:"Zatvori",ko_KR:"닫기",en_US:"Close",lt_LT:"Uždaryti",kk_KZ:"Жабу",no_NO:"Lukk",it_IT:"Chiudi",ru_RU:"Закрыть",el_GR:"Κλείσιμο",pl_PL:"Zamknij",ar_LB:"إغلاق",tr_TR:"Kapat",id_ID:"Tutup",he_IL:"סגירה",fr_FR:"Fermer",ja_JP:"閉じる",de_DE:"Schließen",zh_TW:"關閉",uz_UZ:"Yopish",eu_ES:"Itxi",bg_BG:"Затвори",vi_VN:"Đóng lại",mk_MK:"Затвори",ar_MA:"إغلاق",fi_FI:"Sulje",en_GB:"Close",et_EE:"Sule",ka_GE:"დახურვა",uk_UA:"Закрити",lv_LV:"Aizvērt",zh_CN:"关闭",sl_SI:"Zapri",ar_AE:"إغلاق",pt_PT:"Fechar"},"logout-confirmation-dialog.content":{ro_RO:"Veți încheia conversația actuală, dar o veți putea consulta deschizând din nou chatul.",pt_BR:"Finalizará a conversa atual, mas poderá consultá-la abrindo de novo o chat.",th_TH:"คุณกำลังจะจบการสนทนาปัจจุบัน แต่คุณสามารถสอบถามเพิ่มเติมโดยเปิดบทสนทนาอีกครั้งได้",cs_CZ:"Aktuální konverzaci ukončíte, ale budete ji moci zobrazit opětovným otevřením chatu.",hu_HU:"Az aktuális beszélgetés most véget ér, de a chat megnyitásával újra megnézheti.",ca_ES:"Finalitzareu la conversa actual, però podreu consultar-la obrint de nou el xat.",ar_SA:"ستنهي/ن المحادثة الحالية لكن، يمكنك معاينتها من خلال فتح الدردشة مجددًا.",gl_ES:"Finalizarás a conversa actual, pero poderás consultala abrindo de novo o chat.",es_MX:"Finalizarás la conversación actual, pero podrás consultarla abriendo de nuevo el chat.",sk_SK:"Ukončíte aktuálnu konverzáciu, ale budete si ju môcť pozrieť opätovným otvorením chatu.",es_ES:"Finalizarás la conversación actual, pero podrás consultarla abriendo de nuevo el chat.",nl_NL:"Je sluit dit gesprek nu af, maar je kunt hem later raadplegen door de chat opnieuw te openen.",sq_AL:"Do të përfundosh bisedën aktuale, por mund ta pyesësh duke hapur përsëri chat-in.",sv_SE:"Du avslutar den aktuella konversationen, men du kan läsa den genom att öppna chatten igen.",da_DK:"Du afslutter den nuværende samtale, men du kan altid se den igen ved at åbne chatten igen.",sr_RS:"Dovršićete trenutni razgovor, ali moći ćete da mu pristupite ponovnim otvaranjem ćaskanja.",hr_HR:"Završit ćete trenutačni razgovor, ali moći ćete mu pristupiti otvarajući ponovno chat.",ko_KR:"현재 대화가 종료되지만, 채팅을 다시 열어 확인할 수 있습니다.",en_US:"You will end the current conversation, but you can check it by reopening the chat.",lt_LT:"Baigsite dabartinį pokalbį, bet galėsite pateikti užklausą naujame pokalbyje.",kk_KZ:"Ағымдағы әңгімені аяқтайсыз, бірақ чатты қайта ашу арқылы оны тексеруге болады.",no_NO:"Du vil avslutte den nåværende samtalen, men du kan sjekke den ved å åpne chatten på nytt.",it_IT:"La conversazione in corso verrà conclusa, ma potrai consultarla aprendo nuovamente la chat.",ru_RU:"Текущая беседа завершится, но вы сможете посмотреть ее, вновь открыв чат.",el_GR:"Θα ολοκληρωθεί η τρέχουσα συνομιλία, αλλά μπορείτε να την δείτε ανοίγοντας πάλι το chat.",pl_PL:"Bieżąca rozmowa zostanie zakończona, ale można do niej wrócić otwierając ponownie czat.",ar_LB:"ستنهي/ن المحادثة الحالية لكن، يمكنك معاينتها من خلال فتح الدردشة مجددًا.",tr_TR:"Mevcut konuşmayı sonlandıracaksınız ancak sohbeti tekrar açarak kontrol edebilirsiniz.",id_ID:"Anda akan mengakhiri percakapan ini, tetapi Anda dapat merujuknya dengan membuka chat ini kembali.",he_IL:"השיחה הנוכחית תסתיים, אך תוכלו לשוב ולעיין בה על ידי פתיחת הצ'אט.",fr_FR:"La conversation actuelle va s’achever, mais vous pourrez la consulter en ouvrant le chat à nouveau.",ja_JP:"現在の会話は終了しますが、チャットを再開することで会話を閲覧できます。",de_DE:"Sie beenden das aktuelle Gespräch, können es aber jederzeit noch einmal nachlesen, indem Sie den Chat erneut öffnen.",zh_TW:"目前對話將結束，但您仍可再次打開聊天視窗查看。",uz_UZ:"Joriy suhbat tugatiladi, lekin bu chatni ochib, uni yana tekshirishingiz mumkin.",eu_ES:"Uneko elkarrizketa amaituko duzu, baina hura berriro kontsultatzeko aukera izango duzu txata berriro irekita.",bg_BG:"Ще приключите текущия разговор, но ще можете да го разгледате като отворите чата отново.",vi_VN:"Bạn sẽ kết thúc cuộc trò chuyện hiện tại, nhưng bạn có thể xem lại cuộc trò chuyện này bằng cách mở lại cửa sổ trò chuyện.",mk_MK:"Ќе го завршите тековниот разговор, но може да го проверите со повторно отворање на прозорчето со разговор.",ar_MA:"ستنهي/ن المحادثة الحالية لكن، يمكنك معاينتها من خلال فتح الدردشة مجددًا.",fi_FI:"Nykyinen keskustelu päättyy, mutta voit tarkistaa sen avaamalla chatin uudelleen.",en_GB:"You will end the current conversation, but you can check it by opening the chat again.",et_EE:"Lõpetate praeguse vestluse, kuid saate seda vaadata, kui avate vestluse uuesti.",ka_GE:"მიმდინარე საუბარი დასრულდება, მაგრამ მის ნახვას შეძლებთ ჩატის ხალახლა გახსნით.",uk_UA:"Ви завершите поточну розмову, але зможете переглянути її, відкривши чат знову.",lv_LV:"Tu pabeigsi pašreizējo sarunu, taču varēsi to apskatīt, vēlreiz atverot tērzētavu.",zh_CN:"您将结束当前对话，但您可以再次打开聊天来查看对话。",sl_SI:"Trenutni pogovor boste zaključili, lahko pa boste odprli nov klepet.",ar_AE:"ستنهي/ن المحادثة الحالية لكن، يمكنك معاينتها من خلال فتح الدردشة مجددًا.",pt_PT:"Finalizará a conversa atual, mas poderá consultá-la abrindo de novo o chat."},"minimized-widget.message":{ro_RO:"mesaje noi",pt_BR:"mensagens novas",th_TH:"ข้อความใหม่",cs_CZ:"nové zprávy",hu_HU:"új üzenetek",ca_ES:"Missatges nous",ar_SA:"رسائل جديدة",gl_ES:"mensaxes novas",es_MX:"mensajes nuevos",sk_SK:"nové správy",es_ES:"mensajes nuevos",nl_NL:"nieuwe berichten",sq_AL:"mesazhe të reja",sv_SE:"nya meddelanden",da_DK:"nye beskeder",sr_RS:"nove poruke",hr_HR:"nove poruke/novih poruka",ko_KR:"새로운 메시지",en_US:"new messages",lt_LT:"naujos (-ų) žinutės (-ių)",kk_KZ:"жаңа хабарлар",no_NO:"nye meldinger",it_IT:"nuovi messaggi",ru_RU:"новые сообщения",el_GR:"νέα μηνύματα",pl_PL:"nowe wiadomości",ar_LB:"رسائل جديدة",tr_TR:"yeni mesajlar",id_ID:"pesan baru",he_IL:"הודעות חדשות",fr_FR:"nouveaux messages",ja_JP:"新規メッセージ",de_DE:"neue Nachrichten",zh_TW:"新訊息",uz_UZ:"yangi xabarlar",eu_ES:"mezu berriak",bg_BG:"нови съобщения",vi_VN:"tin nhắn mới",mk_MK:"нови пораки",ar_MA:"رسائل جديدة",fi_FI:"uutta viestiä",en_GB:"new messages",et_EE:"uut sõnumit",ka_GE:"ახალი შეტყობინებები",uk_UA:"нові повідомлення",lv_LV:"jauni ziņojumi",zh_CN:"新消息",sl_SI:"Nova sporočila",ar_AE:"رسائل جديدة",pt_PT:"mensagens novas"},"logout-confirmation-dialog.title":{ro_RO:"Doriți să închideți chatul?",pt_BR:"Deseja encerrar o chat?",th_TH:"คุณต้องการปิดการสนทนาใช่หรือไม่",cs_CZ:"Chcete chat zavřít?",hu_HU:"Bezárja a chatet?",ca_ES:"Voleu tancar el xat?",ar_SA:"هل تريد/ين إغلاق الدردشة؟",gl_ES:"Queres pechar o chat?",es_MX:"¿Quieres cerrar el chat?",sk_SK:"Chcete chat ukončiť?",es_ES:"¿Quieres cerrar el chat?",nl_NL:"Wil je de chat sluiten?",sq_AL:"Dëshiron ta mbyllësh chat-in?",sv_SE:"Vill du stänga chatten?",da_DK:"Ønsker du at afslutte chatten?",sr_RS:"Da li želite da zatvorite chat?",hr_HR:"Želite li zatvoriti chat?",ko_KR:"채팅을 종료하시겠습니까?",en_US:"Would you like to close the chat?",lt_LT:"Norite uždaryti langą?",kk_KZ:"Чатты жапқыңыз келе ме?",no_NO:"Vil du lukke chatten?",it_IT:"Desideri chiudere la chat?",ru_RU:"Хотите закрыть чат?",el_GR:"Θέλεις να κλείσεις τη συνομιλία;",pl_PL:"Zamknąć czat?",ar_LB:"هل تريد/ين إغلاق الدردشة؟",tr_TR:"Sohbeti kapatmak mı istiyorsunuz?",id_ID:"Apakah Anda ingin menutup chat?",he_IL:"האם ברצונך לסגור את הצ'אט?",fr_FR:"Vous souhaitez fermer le chat ?",ja_JP:"チャットを閉じますか?",de_DE:"Möchten Sie den Chat schließen?",zh_TW:"您是否要關閉聊天視窗？",uz_UZ:"Bu chatni yopmoqchimisiz?",eu_ES:"Txata itxi nahi duzu?",bg_BG:"Искате ли да затворите чата?",vi_VN:"Bạn muốn đóng cửa sổ trò chuyện?",mk_MK:"Дали сакате да го затворите прозорчето со разговорот?",ar_MA:"هل تريد/ين إغلاق الدردشة؟",fi_FI:"Haluatko sulkea chatin?",en_GB:"Do you want to close the chat?",et_EE:"Kas soovite vestluse sulgeda?",ka_GE:"გსურთ ჩატის დახურვა?",uk_UA:"Бажаєте закрити чат?",lv_LV:"Vai vēlies aizvērt tērzētavu?",zh_CN:"您要关闭聊天吗？",sl_SI:"Želite klepet zapreti?",ar_AE:"هل تريد/ين إغلاق الدردشة؟",pt_PT:"Pretende encerrar o chat?"},"input.user-message-send-button":{ro_RO:"Trimitere",pt_BR:"Enviar",th_TH:"ส่ง",cs_CZ:"Poslat",hu_HU:"Küldés",ca_ES:"Envia",ar_SA:"إرسال",gl_ES:"Enviar",es_MX:"Enviar",sk_SK:"Poslať",es_ES:"Enviar",nl_NL:"Verzenden",sq_AL:"Dërgo",sv_SE:"Skicka",da_DK:"Send",sr_RS:"Pošalji",hr_HR:"Pošalji",ko_KR:"전송",en_US:"Send",lt_LT:"Siųsti",kk_KZ:"Жіберу",no_NO:"Send",it_IT:"Invia",ru_RU:"Отправить",el_GR:"Αποστολή",pl_PL:"Wyślij",ar_LB:"إرسال",tr_TR:"Gönder",id_ID:"Mengirim",he_IL:"לשלוח",fr_FR:"Envoyer",ja_JP:"送信する",de_DE:"Senden",zh_TW:"傳送",uz_UZ:"Yuborish",eu_ES:"Bidali",bg_BG:"Изпрати",vi_VN:"Gửi",mk_MK:"Испрати",ar_MA:"إرسال",fi_FI:"Lähetä",en_GB:"Send",et_EE:"Saada",ka_GE:"გაგზავნა",uk_UA:"Надіслати",lv_LV:"Sūtīt",zh_CN:"发送",sl_SI:"Pošlji",ar_AE:"إرسال",pt_PT:"Enviar"},"privacy-policy-message.secondary.action":{ro_RO:"Refuz",pt_BR:"Recusar",th_TH:"ปฏิเสธ",cs_CZ:"Odmítnout",hu_HU:"Elutasítás",ca_ES:"Rebutjar",ar_SA:"رفض",gl_ES:"Rexeitar",es_MX:"Rechazar",sk_SK:"Odmietnuť",es_ES:"Rechazar",nl_NL:"Weigeren",sq_AL:"Refuzo",sv_SE:"Avvisa",da_DK:"Afvis",sr_RS:"Odbaci",hr_HR:"Odbaci",ko_KR:"거부",en_US:"Decline",lt_LT:"Atmesti",kk_KZ:"Қабылдамау",no_NO:"Avvis",it_IT:"Rifiuta",ru_RU:"Отказаться",el_GR:"Απόρριψη",pl_PL:"Odrzuć",ar_LB:"رفض",tr_TR:"Reddet",id_ID:"Menolak",he_IL:"דחה",fr_FR:"Refuser",ja_JP:"拒否する",de_DE:"Ablehnen",zh_TW:"拒絕",uz_UZ:"Tashlab ketish",eu_ES:"Baztertu",bg_BG:"Отказ",vi_VN:"Từ chối",mk_MK:"Отфрли",ar_MA:"رفض",fi_FI:"Hylkää",en_GB:"Reject",et_EE:"Keeldu",ka_GE:"უარყოფა",uk_UA:"Відхилити",lv_LV:"Noraidīt",zh_CN:"拒绝",sl_SI:"Zavrni",ar_AE:"رفض",pt_PT:"Recusar"},"input.user-message-label":{ro_RO:"Scriere mesaj",pt_BR:"Escrever mensagem",th_TH:"พิมพ์ข้อความ",cs_CZ:"Napsat vzkaz",hu_HU:"Üzenet írása",ca_ES:"Escriu un missatge",ar_SA:"كتابة رسالة",gl_ES:"Escribir mensaxe",es_MX:"Escribir mensaje",sk_SK:"Napísať správu",es_ES:"Escribir mensaje",nl_NL:"Schrijf een bericht",sq_AL:"Shkruaj mesazh",sv_SE:"Skriv meddelande",da_DK:"Skriv meddelelse",sr_RS:"Napiši poruku",hr_HR:"Napiši poruku",ko_KR:"메시지 입력",en_US:"Write message",lt_LT:"Rašyti pranešimą",kk_KZ:"Хат жазу",no_NO:"Skrive en melding",it_IT:"Scrivi un messaggio",ru_RU:"Написать сообщение",el_GR:"Γράψτε ένα μήνυμα",pl_PL:"Napisz wiadomość",ar_LB:"كتابة رسالة",tr_TR:"Mesaj yaz",id_ID:"Tulis pesan",he_IL:"לכתוב הודעה",fr_FR:"Écrire un message",ja_JP:"メッセージを書く",de_DE:"Nachricht verfassen",zh_TW:"輸入訊息",uz_UZ:"Xabar yozish",eu_ES:"Idatzi mezua",bg_BG:"Напишете съобщение",vi_VN:"Để lại tin nhắn",mk_MK:"Напиши порака",ar_MA:"كتابة رسالة",fi_FI:"Kirjoita viesti",en_GB:"Write message",et_EE:"Kirjuta sõnum",ka_GE:"შეტყობინების დაწერა",uk_UA:"Написати повідомлення",lv_LV:"Rakstīt ziņu",zh_CN:"撰写消息",sl_SI:"Napiši sporočilo",ar_AE:"كتابة رسالة",pt_PT:"Escrever mensagem"},"privacy-policy-confirm-dialog.content":{ro_RO:"Prin refuzarea politicilor, acceptați că sesiunea de chat va fi închisă, iar pentru a iniția o nouă conversație, va fi necesar să vă reconectați.",pt_BR:"Ao rejeitar as políticas, você assume que o chat será encerrado e precisará entrar novamente para iniciar uma conversa.",th_TH:"เมื่อปฏิเสธนโยบาย คุณจะเห็นว่าแชทถูกปิดลง และคุณจะต้องกลับมาเริ่มการสนทนาอีกครั้ง",cs_CZ:"Odmítnutím zásad předpokládáte, že chat bude uzavřen a vy se budete muset znovu přihlásit, abyste mohli začít konverzaci.",hu_HU:"Az irányelvek elutasításával Ön elfogadja, hogy a csevegés bezárul, és újra be kell jelentkeznie a beszélgetés megkezdéséhez.",ca_ES:"En rebutjar les polítiques assumeixes que el xat es tancarà i hauràs de tornar a entrar per iniciar una conversa.",ar_SA:"عند رفض السياسات فأنت تقبل/ين بإغلاق الدردشة وسيتعين عليك معاودة الدخول لبدء محادثة جديدة.",gl_ES:"Ao rexeitar as políticas asumes que o chat se pechará e deberás volver entrar para iniciar unha conversa.",es_MX:"Al rechazar las políticas asumes que el chat se cerrará y deberás volver a entrar para iniciar una conversación.",sk_SK:"Odmietnutím zásad súhlasíte s tým, že chat bude uzavretý a budete sa musieť znova prihlásiť, aby ste mohli začať konverzáciu.",es_ES:"Al rechazar las políticas asumes que el chat se cerrará y deberás volver a entrar para iniciar una conversación.",nl_NL:"Door het beleid af te wijzen, accepteer je dat de chat wordt gesloten en dat je opnieuw moet inloggen om een gesprek te beginnen.",sq_AL:"Duke refuzuar politikat, pranon që chat-i do të mbyllet dhe duhet të identifikohesh përsëri për të filluar një bisedë.",sv_SE:"Chatten kommer att stängas i och med att du avvisar policyerna. Du måste logga in igen för att starta en konversation.",da_DK:"Hvis du afviser politikkerne, lukkes chatten, og du skal logge ind igen for at starte en ny samtale.",sr_RS:"Odbijanjem smernica prihvatate da će se ćaskanje zatvoriti i moraćete da se ponovo prijavite da biste započeli razgovor.",hr_HR:"Odbijanjem pravila shvaćate da će se chat zatvoriti i da ćete se morati ponovno prijaviti da biste započeli razgovor.",ko_KR:"정책을 거부하는 경우 채팅이 종료되며 대화를 시작하려면 다시 입력해야 합니다.",en_US:"By rejecting the policies you accept that the chat will close and you will have to log in again to start a conversation.",lt_LT:"Atmesdami politiką suprantate, kad pokalbis bus uždarytas ir norint pradėti pokalbį teks prisijungti iš naujo.",kk_KZ:"Саясаттарды қабылдамау арқылы чаттың жабылатынын растайсыз және әңгіме бастау үшін аккаунтқа қайта кіруіңіз қажет болады.",no_NO:"Ved å avvise retningslinjene forstår du at chatten vil bli stengt og at du må åpne den på nytt for å starte en samtale.",it_IT:"Rifiutando le politiche, accetti che la chat venga chiusa e di dover accedere nuovamente per iniziare una conversazione.",ru_RU:"Отказываясь от политики, вы соглашаетесь с тем, что чат будет закрыт и вам нужно будет заново войти в него, чтобы начать разговор.",el_GR:"Απορρίπτοντας τις πολιτικές υποθέτετε ότι η συνομιλία θα κλείσει και θα πρέπει να συνδεθείτε ξανά για να ξεκινήσετε μια συζήτηση.",pl_PL:"Odrzucając politykę, zakładasz, że czat zostanie zamknięty i będziesz musiał zalogować się ponownie, aby rozpocząć rozmowę.",ar_LB:"عند رفض السياسات فأنت تقبل/ين بإغلاق الدردشة وسيتعين عليك معاودة الدخول لبدء محادثة جديدة.",tr_TR:"Politikaları reddederek sohbetin kapatılacağını ve bir konuşma başlatmak için tekrar giriş yapmanız gerekeceğini kabul edersiniz.",id_ID:"Saat menolak kebijakan, Anda memahami bahwa chat akan ditutup dan Anda harus masuk kembali untuk memulai percakapan.",he_IL:"על ידי דחיית המדיניות, אתם מניחים שהצ'אט ייסגר ותצטרכו להיכנס שוב כדי להתחיל שיחה.",fr_FR:"En refusant les politiques, vous acceptez que le chat soit fermé et que vous deviez vous connecter à nouveau pour commencer une conversation.",ja_JP:"ポリシーを拒否すると、チャットが終了し、会話を開始するには再度ログインする必要があるものとみなされます。",de_DE:"Wenn Sie die Richtlinien ablehnen, bedenken Sie, dass der Chat geschlossen wird und Sie sich erneut anmelden müssen, um ein Gespräch zu beginnen.",zh_TW:"拒絕相關政策即表示聊天室即將關閉，您需要重新登入才能開始對話。",uz_UZ:"Siyosatlarni rad etish orqali siz chat yopilishini tan olasiz va suhbatni boshlash uchun yana kirishingiz kerak boʻladi.",eu_ES:"Politikak baztertzean, onartzen duzu txata itxi egingo dela eta berriro sartu beharko zarela elkarrizketa bat hasteko.",bg_BG:"С отхвърлянето на политиките приемате, че чатът ще бъде затворен и ще трябва да влезете отново, за да започнете разговор.",vi_VN:"Khi từ chối các chính sách, bạn đồng ý rằng cuộc trò chuyện sẽ bị đóng và bạn sẽ cần truy cập lại để bắt đầu một cuộc trò chuyện mới.",mk_MK:"Со отфрлање на политиките, претпоставувате дека разговорот ќе се затвори и ќе треба повторно да се најавите за да започнете разговор.",ar_MA:"عند رفض السياسات فأنت تقبل/ين بإغلاق الدردشة وسيتعين عليك معاودة الدخول لبدء محادثة جديدة.",fi_FI:"Hylkäämällä käytännöt oletat, että chatti sulkeutuu ja sinun täytyy kirjautua uudelleen sisään aloittaaksesi keskustelun.",en_GB:"By rejecting the policies you acknowledge that the chat will be closed and you will have to log in again to start a conversation.",et_EE:"Poliitikate tagasilükkamisega eeldad, et vestlus suletakse ja pead vestluse alustamiseks uuesti sisse logima.",ka_GE:"წესებზე უარის თქმით, უნდა იცოდეთ, რომ ჩატი დაიხურება და ხელახლა მოგიწევთ შესვლა საუბრის დასაწყებად.",uk_UA:"Відхиляючи політики, ви погоджуєтеся, що чат буде закрито і вам доведеться знову увійти в систему, щоб почати розмову.",lv_LV:"Noraidot politikas, jūs piekrītat, ka tērzēšana tiks atstāta un jums būs jāpiesakās vēlreiz, lai sāktu sarunu.",zh_CN:"拒绝这些政策即表示聊天将被关闭，您必须重新登录方可开始对话。",sl_SI:"Z zavrnitvijo pravilnikov predvidevate, da bo klepet zaprt in da se boste morali za začetek pogovora znova prijaviti.",ar_AE:"عند رفض السياسات فأنت تقبل/ين بإغلاق الدردشة وسيتعين عليك معاودة الدخول لبدء محادثة جديدة.",pt_PT:"Ao rejeitar as políticas, aceita que o chat será encerrado e terá de iniciar sessão novamente para começar uma conversa."},"minimized-widget-mobile.title":{ro_RO:"înapoi la chat",pt_BR:"voltar ao chat",th_TH:"กลับไปที่การสนทนา",cs_CZ:"zpět k chatu",hu_HU:"Vissza a chathez",ca_ES:"tornar al xat",ar_SA:"الرجوع إلى الدردشة",gl_ES:"volver ao chat",es_MX:"volver al chat",sk_SK:"späť na chat",es_ES:"volver al chat",nl_NL:"terugkeren naar de chat",sq_AL:"kthehu te chat-i",sv_SE:"tillbaka till chatten",da_DK:"tilbage til chatten",sr_RS:"nazad na chat",hr_HR:"natrag na chat",ko_KR:"채팅으로 돌아가기",en_US:"return to chat",lt_LT:"grįžti į pokalbį",kk_KZ:"чатқа оралу",no_NO:"gå tilbake til chat",it_IT:"ritorna alla chat",ru_RU:"вернуться в чат",el_GR:"επιστροφή στη συνομιλία",pl_PL:"powrót do czatu",ar_LB:"الرجوع إلى الدردشة",tr_TR:"sohbete dön",id_ID:"kembali ke obrolan",he_IL:"לחזור לצ'ט",fr_FR:"retour au chat",ja_JP:"チャットに戻る",de_DE:"zurück zum Chat",zh_TW:"返回聊天室",uz_UZ:"chatga qaytish",eu_ES:"itzuli txatera",bg_BG:"обратно към чата",vi_VN:"quay lại mục trò chuyện",mk_MK:"врати се на разговорот",ar_MA:"الرجوع إلى الدردشة",fi_FI:"palaa keskusteluun",en_GB:"back to chat",et_EE:"tagasi vestlusse",ka_GE:"ჩატში დაბრუნება",uk_UA:"повернутися в чат",lv_LV:"atgriezties pie tērzēšanas",zh_CN:"返回聊天窗口",sl_SI:"Nazaj na klepet",ar_AE:"الرجوع إلى الدردشة",pt_PT:"voltar ao chat"},"message.aria-label-agent":{ro_RO:"Mesajul agentului",pt_BR:"Mensagem de agente",th_TH:"ข้อความจากพนักงาน",cs_CZ:"Zpráva od agenta",hu_HU:"Ügynök üzenete",ca_ES:"Missatge d’agent",ar_SA:"رسالة وكيل",gl_ES:"Mensaxe de axente",es_MX:"Mensaje de agente",sk_SK:"Správa agenta",es_ES:"Mensaje de agente",nl_NL:"Bericht van medewerker",